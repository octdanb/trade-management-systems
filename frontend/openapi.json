{"openapi": "3.1.0", "info": {"title": "Trade Management API", "version": "0.1.0", "description": ""}, "paths": {"/api/health": {"get": {"operationId": "health", "summary": "Health", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthOut"}}}}}, "description": "Liveness check. Also ensures the CSRF cookie is set for the SPA."}}, "/api/me": {"get": {"operationId": "getMe", "summary": "Me", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserOut"}}}}}, "security": [{"SessionAuth": []}]}}, "/api/trades": {"get": {"operationId": "listTrades", "summary": "List Trades", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/TradeOut"}, "title": "Response", "type": "array"}}}}}, "security": [{"SessionAuth": []}]}, "post": {"operationId": "createTrade", "summary": "Create Trade", "parameters": [], "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TradeOut"}}}}}, "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/TradeIn"}}}, "required": true}, "security": [{"SessionAuth": []}]}}, "/api/trades/{trade_id}": {"delete": {"operationId": "deleteTrade", "summary": "Delete Trade", "parameters": [{"in": "path", "name": "trade_id", "schema": {"title": "Trade Id", "type": "integer"}, "required": true}], "responses": {"204": {"description": "No Content"}}, "security": [{"SessionAuth": []}]}}}, "components": {"schemas": {"HealthOut": {"properties": {"status": {"title": "Status", "type": "string"}}, "required": ["status"], "title": "HealthOut", "type": "object"}, "UserOut": {"properties": {"id": {"title": "Id", "type": "integer"}, "username": {"title": "Username", "type": "string"}, "email": {"title": "Email", "type":