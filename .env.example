# Copy to .env — docker compose picks it up automatically.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID of type "Web application" with:
#   Authorized JavaScript origins: http://localhost:5173
#   Authorized redirect URIs:      http://localhost:5173/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Nominatim usage policy requires an identifying User-Agent with a contact
# address. Set this to something like: my-lawn-app/0.1 (you@example.com)
GEOCODER_USER_AGENT=

# Optional overrides (defaults: public OSM servers, NZ-biased geocoding)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEOCODER_COUNTRY_CODES=nz

# --- Photo storage (S3-compatible) -------------------------------------------
# docker compose defaults to the bundled MinIO (console: http://localhost:9001,
# login minioadmin/minioadmin) — nothing to configure locally.
#
# For real AWS S3 in production, set:
#   USE_S3_MEDIA=true
#   AWS_ACCESS_KEY_ID=...            (or use an instance role and omit keys)
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_STORAGE_BUCKET_NAME=my-app-media
#   AWS_S3_REGION_NAME=ap-southeast-2
#   AWS_S3_ENDPOINT_URL=             (leave unset for AWS)
# then EITHER a public bucket/CDN:
#   AWS_S3_CUSTOM_DOMAIN=cdn.example.com
#   AWS_S3_URL_PROTOCOL=https:
# OR a private bucket with signed, expiring URLs:
#   AWS_S3_CUSTOM_DOMAIN=
#   AWS_QUERYSTRING_AUTH=true

# Shared secret for the Mobile Build workflow to publish APKs to the backend
# (POST /api/app/builds). Set the same value in the GitHub `production`
# environment secrets. Leave empty to disable CI uploads.
APP_BUILD_UPLOAD_TOKEN=
